{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "wayfinder:generate": "php artisan wayfinder:generate",
        "types:check": "npm run wayfinder:generate && tsc --noEmit",
        "test": "npm run wayfinder:generate && vitest run",
        "test:watch": "vitest",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css"
    },
    "dependencies": {
        "@inertiajs/react": "^2.3.7",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-select": "^2.1.6",
        "@tailwindcss/vite": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.9.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.66.0",
        "vite": "^7.0.4",
        "vitest": "^4.1.10"
    }
}
